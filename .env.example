# .env.example (placeholders only)
MONGODB_URI="mongodb+srv://<USERNAME>:<PASSWORD>@cluster0.qmgryia.mongodb.net/?retryWrites=true&w=majority&appName=Cluster0"
MONGODB_DB_NAME="ai-mock-interview"
MONGODB_TEST_DB_NAME="ai-mock-interview-test"
MONGODB_USERNAME="<USERNAME>"
MONGODB_PASSWORD="<PASSWORD>"
MONGODB_MAX_POOL_SIZE=20
MONGODB_MIN_POOL_SIZE=1
MONGODB_SERVER_SELECTION_TIMEOUT_MS=8000
MONGODB_CONNECT_TIMEOUT_MS=8000

# Security & Authentication
JWT_SECRET="changeme_replace_with_a_secure_random_hex_key_at_least_32_chars"
JWT_EXPIRE_MINUTES=60
CORS_ORIGINS="http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000"

# AI Provider Configuration ("openai" or "google")
LLM_PROVIDER="google"
OPENAI_API_KEY=""
GOOGLE_API_KEY=""

# Embedding and RAG Configuration (§4)
EMBEDDING_PROVIDER="openai"          # openai | google
EMBEDDING_MODEL="text-embedding-3-small"
EMBEDDING_DIMENSIONS=1536          # must match the Atlas vector index
RAG_TOP_K=4
RAG_MAX_CONTEXT_TOKENS=1800
VECTOR_INDEX_RESUME="resume_chunks_vector"
VECTOR_INDEX_KB="knowledge_base_vector"
VECTOR_INDEX_MEMORY="interview_memory_vector"
DUPLICATE_SIMILARITY_THRESHOLD=0.88
MAX_FOLLOWUPS_PER_TOPIC=2

# Upload and Storage Limits
MAX_UPLOAD_MB=5

# Server Configuration
HOST="0.0.0.0"
PORT=8000
ENVIRONMENT="development"
